# [ES] Copiar a .env (cp .env.example .env). Valores ficticios: cambiar en un entorno real.
# [ES] Entorno: development | production | test
NODE_ENV=development
PORT=3000

# [ES] Conexión a PostgreSQL (docker compose expone la BD en el puerto 5433)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fleetcore
# [ES] true = TypeORM crea/ajusta las tablas automáticamente (solo desarrollo)
DB_SYNC=true

# [ES] Secreto para firmar los JWT (mínimo 32 caracteres) y duración en segundos
JWT_SECRET=change-me-with-a-long-secret-of-32-chars-or-more
JWT_EXPIRES_IN=3600

# [ES] Cuenta administradora creada al arrancar y por npm run seed
ADMIN_EMAIL=admin@fleetcore.com
ADMIN_PASSWORD=Admin12345

# [ES] Keys aceptadas en el header x-api-key, separadas por coma (una por partner)
API_KEYS=demo-key-partner-1,demo-key-partner-2
